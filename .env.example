# Server-side only: read by api/tmdb.ts, never sent to the browser. Set it in Vercel → Project → Settings → Environment Variables.
# A TMDB API Read Access Token (the long one, not the short v3 API key). Leave empty to run without TMDB (Kitsu and TVmaze still work).
TMDB_API_KEY=

# Optional: Google Drive sync. Create a Web OAuth client in Google Cloud (see README → Google Drive sync).
# VITE_GOOGLE_CLIENT_ID is public (built into the app). GOOGLE_CLIENT_SECRET is server-only, read by api/google-token.ts.
# Leave both empty to hide Drive sync; everything else still works.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: short share links, read by api/share.ts. Connecting Upstash for Redis in Vercel's Marketplace sets these for you.
# Leave empty and the app falls back to long links that hold the whole list.
KV_REST_API_URL=
KV_REST_API_TOKEN=
